{
  "name": "eve-web",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build && node tools/check-build.mjs",
    "check": "biome check . && tsc --noEmit && node tools/check-size.mjs && node tools/check-imports.mjs && node --test tools/*.test.mjs",
    "format": "biome format --write .",
    "test": "bash tests/run_all.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "preact": "11.1.0"
  }
}
